# Run python3 scripts/init-env.py first, then choose your public HTTPS origin.
PARTNER_ORIGIN=https://partner.example.com
PARTNER_HOST=partner.example.com
PARTNER_ID=change_me
# B: sample-issued OAuth credentials; copy these to Musecat Direction B settings.
PARTNER_OAUTH_CLIENT_ID=musecat
PARTNER_OAUTH_CLIENT_SECRET=
# Joint only: sample-issued key; copy it to Musecat Joint credentials.
MUSECAT_TO_PARTNER_KEY=
MUSECAT_TO_PARTNER_PREVIOUS_KEY=
PREVIOUS_KEY_EXPIRES_AT=0
# Musecat-issued server key: required for B privacy/selection cache invalidation and Joint.
PARTNER_TO_MUSECAT_KEY=
# A and Joint: issued by Musecat after registration. Not used by the B-only flow.
MUSECAT_CLIENT_SECRET=
MUSECAT_ISSUER=https://db-dev.musecat.app
MUSECAT_WEB_ORIGIN=https://preview.musecat.app
# Local demo runtime: init-env generates these even if you use only one flow.
DEMO_PASSWORD=
SESSION_SECRET=
DATA_KEY=

# Separate login-only app; avoids invalidating the existing A/B/Joint demo grants.
MUSECAT_LOGIN_CLIENT_ID=change_me_login
MUSECAT_LOGIN_CLIENT_SECRET=
